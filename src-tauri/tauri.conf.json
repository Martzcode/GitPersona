{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPersona",
  "version": "0.1.0",
  "identifier": "com.gitpersona.app",
  "build": {
    "frontendDist": "../frontend/dist/frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix frontend run start",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "GitPersona",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
